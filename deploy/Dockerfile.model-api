# Reuse the verified offline BGE bundle; never download serving models at startup.
# Full clean builds remain supported by Dockerfile.bge.
FROM docker.io/suqihang/atlas-desk:20261001-business.2@sha256:ffd26cec82d7db74601cdfe4d670fdde12c3aaf3fea28c752bd1fa47cb8a1b8a
COPY requirements.txt /app/requirements.txt
RUN python -c "import cryptography; assert cryptography.__version__ == '50.0.2'"
COPY app /app/app
