# 应用配置
APP_NAME=Atlas Desk · 智能工单处理 Agent（个人项目）
APP_ENV=dev
DATABASE_URL=data/tickets.db

# 安全配置：生产环境必须填写；密码哈希用 python -m app.security 生成
SESSION_SECRET=
ADMIN_PASSWORD_HASH=
ADMIN_USERNAME=admin
# 默认保留正式评测门槛；个人只读辅助演示可显式开启，不代表质量评测已通过。
LOW_RISK_ASSISTANCE=false
# 允许低风险只读自助进入AI流程；关闭后须人工预审，不授予系统/设备权限。
AUTO_APPROVE_LOW_RISK=true
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET=
MAX_PUBLIC_HOURLY=10
MAX_LLM_DAILY=100

# 企业审批配置
HIGH_RISK_KEYWORDS=生产,支付,订单,财务,法务,高管,管理员,批量,数据删除,权限提升,海外访问

# 大模型配置（不填也能正常运行，系统会用本地知识库兜底）
# auto 会优先使用 Windows/Linux 环境中的 MIMO_API_KEY；disabled 强制离线。
LLM_PROVIDER=auto
MIMO_API_KEY=
MIMO_BASE_URL=https://api.xiaomimimo.com/v1
MIMO_MODEL=mimo-v2.5-pro
LLM_API_KEY=
LLM_BASE_URL=
LLM_MODEL=gpt-5-mini

# local 使用约 90 MB 的中文 ONNX 模型；资源不足可改 gemini 或 disabled
EMBEDDING_PROVIDER=local
EMBEDDING_MODEL=BAAI/bge-small-zh-v1.5
