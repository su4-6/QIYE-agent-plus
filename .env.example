# 应用配置
APP_NAME=Atlas Desk · 智能工单处理 Agent（个人项目）
APP_ENV=dev
DATABASE_URL=data/tickets.db

# 本地与生产均需会话密钥和管理员密码哈希；scripts/setup-local.py 可生成本地配置。
# 手动生成密码哈希：python -m app.security。生产还必须配置 Turnstile。
SESSION_SECRET=
ADMIN_PASSWORD_HASH=
ADMIN_USERNAME=admin
# 默认保留正式评测门槛；个人只读辅助演示可显式开启，不代表质量评测已通过。
LOW_RISK_ASSISTANCE=false
# 允许低风险只读自助进入AI流程；关闭后须人工预审，不授予系统/设备权限。
AUTO_APPROVE_LOW_RISK=true
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET=
MAX_PUBLIC_HOURLY=10
MAX_LLM_DAILY=100

# 企业审批配置
HIGH_RISK_KEYWORDS=生产,支付,订单,财务,法务,高管,管理员,批量,数据删除,权限提升,海外访问

# 首次启动默认离线：可验证账号、工单和审批；不会生成 AI 答复。
# auto 会优先使用 Windows/Linux 环境中的 MIMO_API_KEY；disabled 强制离线。
# 这里控制部署默认连接；管理台已保存的模型配置优先，离线前须恢复部署默认。
LLM_PROVIDER=disabled
MIMO_API_KEY=
MIMO_BASE_URL=https://api.xiaomimimo.com/v1
MIMO_MODEL=mimo-v2.6-flash
# 每轮辅助共享模型调用等待预算；建议保留40秒，草案/审查/有限修正共用。
SUPPORT_BUDGET_SECONDS=40
LLM_API_KEY=
LLM_BASE_URL=
LLM_MODEL=gpt-5-mini
# 管理台支持 MiMo、DeepSeek、OpenAI；其他兼容地址需维护者精确允许，逗号分隔。
# Key 在数据库中加密保存，依赖 SESSION_SECRET；不要把 Key 填入下面的地址清单。
MODEL_API_ALLOWED_BASE_URLS=

# disabled 使用 FTS5/BM25，不下载模型；local 开启 BGE 中文向量，首次需下载。
EMBEDDING_PROVIDER=disabled
EMBEDDING_MODEL=BAAI/bge-small-zh-v1.5
